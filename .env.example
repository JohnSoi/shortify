# Environment: development | testing | production
ENVIRONMENT=development
DEBUG=True
BASE_URL=http://localhost:5173

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=shortlink_pass
POSTGRES_DB=shortlink_db
DATABASE_URL=postgresql+asyncpg://shortlink:shortlink_pass@postgres:5432/shortlink_db

# Redis
REDIS_URL=redis://redis:6379/0

# GeoIP
GEOIP_DB_PATH=/app/geoip/GeoLite2-City.mmdb
